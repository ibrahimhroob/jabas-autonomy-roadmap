<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jabas_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters for the JABAS autonomy stack skeleton.</description>
  <maintainer email="autonomy@jabas.ai">JABAS AI Autonomy</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>jabas_world_model</exec_depend>
  <exec_depend>jabas_health</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
